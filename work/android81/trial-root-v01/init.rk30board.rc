# Experimental recovery-slot boot. Never mounts the stock system partition.
on early-init
    mkdir /realdata 0700 root root

on init
    setprop debug.sf.no_hw_vsync 0
    mkdir /dev/usb-ffs 0770 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    mount functionfs adb /dev/usb-ffs/adb uid=2000,gid=2000
    write /sys/class/android_usb/android0/enable 0
    write /sys/class/android_usb/android0/idVendor 18D1
    write /sys/class/android_usb/android0/idProduct D001
    write /sys/class/android_usb/android0/f_ffs/aliases adb
    write /sys/class/android_usb/android0/functions adb
    write /sys/class/android_usb/android0/iManufacturer Canon
    write /sys/class/android_usb/android0/iProduct Rayo-Oreo-Trial
    write /sys/class/android_usb/android0/iSerial ${ro.serialno}
    write /sys/class/android_usb/android0/enable 1
    start adbd

on fs
    exec u:r:init:s0 root root -- /sbin/busybox sh /sbin/rayo-mount-trial.sh
    mount_all /fstab.rk30board

on post-fs
    exec u:r:init:s0 root root -- /sbin/busybox sh /sbin/rayo-overlay.sh
    restorecon_recursive /vendor/bin /vendor/lib /vendor/etc
    restorecon_recursive /system/lib /system/etc
    insmod /drmboot.ko
    insmod /sbin/rayo_hwbinder.ko armed=1
    wait /dev/hwbinder 5
    wait /dev/vndbinder 5
    chmod 0666 /dev/hwbinder
    chmod 0666 /dev/vndbinder
    exec u:r:init:s0 root root -- /sbin/rayo-wifi-caps --apply

on post-fs-data
    mkdir /data/misc/bluedroid 0770 bluetooth bluetooth
    mkdir /data/misc/bluetooth 0770 bluetooth bluetooth
    mkdir /data/misc/wifi 0770 wifi wifi
    mkdir /data/misc/wifi/sockets 0770 wifi wifi
    mkdir /data/misc/wifi/wpa_supplicant 0770 wifi wifi
    mkdir /data/misc/wpa_supplicant 0770 wifi wifi
    chown wifi wifi /sys/module/bcmdhd/parameters/firmware_path
    chmod 0660 /dev/ttyS0
    chown bluetooth bluetooth /dev/ttyS0

on boot
    setprop sys.usb.configfs 0
    setprop sys.usb.config adb

service rayo_allocator /vendor/bin/hw/android.hardware.graphics.allocator@2.0-service
    class hal
    user system
    group graphics drmrpc
    seclabel u:r:hal_graphics_allocator_default:s0

service rayo_keymaster /vendor/bin/hw/android.hardware.keymaster@3.0-service
    class hal
    user system
    group system drmrpc
    seclabel u:r:hal_keymaster_default:s0

service wpa_supplicant /vendor/bin/hw/wpa_supplicant -iwlan0 -Dnl80211 -c/data/misc/wifi/wpa_supplicant.conf -g@android:wpa_wlan0
    class main
    socket wpa_wlan0 dgram 0660 wifi wifi
    user root
    group wifi inet net_admin net_raw
    disabled
    oneshot
    seclabel u:r:hal_wifi_supplicant_default:s0

