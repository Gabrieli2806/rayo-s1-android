cc_binary {
    name: "rayo12_bootstrap_probe",
    srcs: ["bootstrap_probe.c"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
    shared_libs: ["libdl"],
    stl: "none",
}

cc_binary {
    name: "rayo12_buffer_probe",
    vendor: true,
    srcs: ["buffer_probe.cpp"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
    header_libs: [
        "android.hardware.graphics.allocator@2.0-passthrough",
        "android.hardware.graphics.mapper@2.0-passthrough",
    ],
    shared_libs: [
        "android.hardware.graphics.allocator@2.0",
        "android.hardware.graphics.mapper@2.0",
        "libbase", "libcutils", "libhardware", "libhidlbase",
        "liblog", "libsync", "libutils",
    ],
}

cc_library_shared {
    name: "hwcomposer.rayo12",
    vendor: true,
    relative_install_path: "hw",
    srcs: ["hwc_adapter12.cpp"],
    cflags: ["-Wall", "-Wextra", "-Werror", "-DTARGET_BOARD_PLATFORM_RK312X"],
    header_libs: ["libhardware_headers"],
    shared_libs: ["liblog", "libdl", "libvndksupport"],
    stl: "none",
}

cc_binary {
    name: "rayo12_graphicbuffer_probe",
    srcs: ["graphicbuffer_probe.cpp"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
    shared_libs: ["libui", "libutils"],
}

filegroup {
    name: "rayo12_early_init_source",
    srcs: ["early_init_bootstrap.c"],
}

cc_binary {
    name: "rayo12_composer_probe",
    srcs: ["composer_probe.cpp"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
    shared_libs: ["android.hardware.graphics.composer@2.1", "libhidlbase", "libutils", "liblog"],
}

cc_binary {
    name: "rayo12_surface_probe",
    srcs: ["surface_probe.cpp"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
    shared_libs: ["libgui", "libui", "libbinder", "libutils", "liblog"],
}

cc_binary {
    name: "rayo12_stage1_props",
    srcs: ["stage1_props.c"],
    static_executable: true,
    stl: "none",
    static_libs: ["libc", "libm", "libdl"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
}
