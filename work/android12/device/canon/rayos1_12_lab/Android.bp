cc_binary {
    name: "rayo12_bootstrap_probe",
    srcs: ["bootstrap_probe.c"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
    shared_libs: ["libdl"],
    stl: "none",
}

cc_binary {
    name: "rayo12_buffer_probe",
    vendor: true,
    srcs: ["buffer_probe.cpp"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
    header_libs: [
        "android.hardware.graphics.allocator@2.0-passthrough",
        "android.hardware.graphics.mapper@2.0-passthrough",
    ],
    shared_libs: [
        "android.hardware.graphics.allocator@2.0",
        "android.hardware.graphics.mapper@2.0",
        "libbase", "libcutils", "libhardware", "libhidlbase",
        "liblog", "libsync", "libutils",
    ],
}

cc_library_shared {
    name: "hwcomposer.rayo12",
    vendor: true,
    relative_install_path: "hw",
    srcs: ["hwc_adapter12.cpp"],
    cflags: ["-Wall", "-Wextra", "-Werror", "-DTARGET_BOARD_PLATFORM_RK312X"],
    header_libs: ["libhardware_headers"],
    shared_libs: ["liblog", "libdl", "libvndksupport"],
    stl: "none",
}

cc_binary {
    name: "rayo12_graphicbuffer_probe",
    srcs: ["graphicbuffer_probe.cpp"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
    shared_libs: ["libui", "libutils"],
}

filegroup {
    name: "rayo12_early_init_source",
    srcs: ["early_init_bootstrap.c"],
}

filegroup {
    name: "rayo12_framework_init_source",
    srcs: ["framework_bootstrap.c"],
}

cc_binary {
    name: "rayo12_composer_probe",
    srcs: ["composer_probe.cpp"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
    shared_libs: ["android.hardware.graphics.composer@2.1", "libhidlbase", "libutils", "liblog"],
}

cc_binary {
    name: "rayo12_surface_probe",
    srcs: ["surface_probe.cpp"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
    shared_libs: ["libgui", "libui", "libbinder", "libutils", "liblog"],
}

cc_binary {
    name: "rayo12_stage1_props",
    srcs: ["stage1_props.c"],
    static_executable: true,
    stl: "none",
    static_libs: ["libc", "libm", "libdl"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
}
// A separate upstream non-FIPS backend for the measured pre-getrandom kernel.
// Never replace or relabel the platform FIPS module with this library.
cc_library_shared {
    name: "librayo12_crypto_legacy",
    whole_static_libs: ["libcrypto_static"],
    export_static_lib_headers: ["libcrypto_static"],
    shared_libs: ["libc", "libm", "libdl"],
    ldflags: ["-Wl,-Bsymbolic"],
    stl: "none",
}

cc_binary {
    name: "rayo12_crypto_probe",
    srcs: ["crypto_probe.c"],
    shared_libs: ["librayo12_crypto_legacy"],
    stl: "none",
    cflags: ["-Wall", "-Wextra", "-Werror"],
}

cc_library_shared {
    name: "librayo12_bt_timer_compat",
    stem: "libtg",
    vendor: true,
    srcs: ["bt_timer_compat.c"],
    shared_libs: ["libdl"],
    stl: "none",
    cflags: ["-Wall", "-Wextra", "-Werror"],
}

// Only the source facade links current libutils; the factory core stays in sphal.
cc_library_shared {
    name: "librayo12_omx_plugin",
    srcs: ["omx_plugin_bridge.cpp"],
    header_libs: ["media_plugin_headers"],
    shared_libs: ["libbase", "libutils", "liblog", "libdl", "libvndksupport"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
}

cc_binary {
    name: "rayo12_omx_plugin_probe",
    srcs: ["omx_plugin_probe.cpp"],
    header_libs: ["media_plugin_headers"],
    shared_libs: ["libutils", "libdl"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
}
