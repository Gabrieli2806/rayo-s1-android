# File capabilities are verified in the image: this kernel has no ambient caps.
on post-fs-data
    # The pinned kernel enables RT group scheduling. Bluetooth's foreground
    # group otherwise has zero budget and Android 12 deliberately aborts.
    # Use the already observed root CPU group's 950 ms / 1 s RT budget.
    write /dev/cpuctl/foreground/cpu.rt_runtime_us 950000
    mkdir /data/vendor 0771 root root
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi
    mkdir /data/misc/bluedroid 0770 bluetooth bluetooth
    mkdir /data/misc/bluetooth 0770 bluetooth bluetooth
    chown wifi wifi /sys/module/bcmdhd/parameters/firmware_path
    chmod 0660 /sys/module/bcmdhd/parameters/firmware_path
    chown bluetooth bluetooth /dev/ttyS0
    chmod 0660 /dev/ttyS0
    chown bluetooth bluetooth /sys/class/rfkill/rfkill0/state
    chmod 0660 /sys/class/rfkill/rfkill0/state
    chown bluetooth bluetooth /proc/bluetooth/sleep/lpm
    chown bluetooth bluetooth /proc/bluetooth/sleep/btwrite
    chmod 0660 /proc/bluetooth/sleep/lpm
    chmod 0660 /proc/bluetooth/sleep/btwrite
    chown bluetooth bluetooth /dev/vendor_storage
    chown bluetooth bluetooth /dev/vflash
    chmod 0660 /dev/vendor_storage
    chmod 0660 /dev/vflash

service rayo12_wifi /system/bin/android.hardware.wifi@1.0-service
    class hal
    user wifi
    group wifi gps inet
    setenv LD_PRELOAD /system/lib/librayo12_crypto_legacy.so
    interface android.hardware.wifi@1.0::IWifi default
    interface android.hardware.wifi@1.1::IWifi default
    interface android.hardware.wifi@1.2::IWifi default
    interface android.hardware.wifi@1.3::IWifi default
    interface android.hardware.wifi@1.4::IWifi default
    interface android.hardware.wifi@1.5::IWifi default
    stdio_to_kmsg

service rayo12_bluetooth /system/bin/android.hardware.bluetooth@1.0-service
    class hal
    user bluetooth
    group bluetooth
    interface android.hardware.bluetooth@1.0::IBluetoothHci default
    stdio_to_kmsg

service wpa_supplicant /system/bin/wpa_supplicant -O/data/vendor/wifi/wpa/sockets -g@android:wpa_wlan0
    class main
    user wifi
    group wifi inet keystore
    setenv LD_PRELOAD /system/lib/librayo12_crypto_legacy.so
    interface android.hardware.wifi.supplicant@1.0::ISupplicant default
    interface android.hardware.wifi.supplicant@1.1::ISupplicant default
    interface android.hardware.wifi.supplicant@1.2::ISupplicant default
    interface android.hardware.wifi.supplicant@1.3::ISupplicant default
    interface android.hardware.wifi.supplicant@1.4::ISupplicant default
    socket wpa_wlan0 dgram 0660 wifi wifi
    disabled
    oneshot
    stdio_to_kmsg
